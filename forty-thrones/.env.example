# ---- Core ----
NODE_ENV=development
PORT=3000
# Public URL of the site (no trailing slash). Used for redirects and origin checks.
BASE_URL=http://localhost:3000
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me
# Where SQLite and uploaded images live. MUST be on a persistent disk in production.
DATA_DIR=./data

# ---- Game rules ----
# Floor price in US cents (100 = $1.00)
FLOOR_PRICE_CENTS=100
# Hours a tile is locked after each purchase. NOT YET DECIDED in the proposal: pick deliberately.
FREEZE_HOURS=24
CAPTION_MAX=100
# 0 = no limit. Otherwise max total spend per account, in cents.
MAX_SPEND_PER_ACCOUNT_CENTS=0
# Terms version stored with every consent record. Bump when you change the terms text.
CONSENT_VERSION=2026-10-v1

# ---- Google Sign-In ----
# Create an OAuth Web client at https://console.cloud.google.com/apis/credentials
# Add BASE_URL as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=

# ---- Payments ----
# mock = fake checkout page (development only, refused when NODE_ENV=production)
# lemonsqueezy = real checkout
PAYMENT_PROVIDER=mock
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---- Admin (content removal, reports, refund queue) ----
# Long random string. Sent as header: Authorization: Bearer <token>
ADMIN_TOKEN=

# ---- Email (neutral "your throne was taken" notice). Leave SMTP_HOST empty to only log. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Forty Thrones <no-reply@example.com>"
